---
// One pitfall as a native disclosure: closed by default, Enter/Space toggle, state exposed to assistive tech.
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<details class="pitfall">
  <summary>
    <span class="pitfall-tag">WARN</span>
    <span class="pitfall-title">{title}</span>
    <span class="pitfall-chev" aria-hidden="true">›</span>
  </summary>
  <div class="pitfall-body"><slot /></div>
</details>
