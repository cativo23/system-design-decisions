---
// Rendered inside a card's "## Related" section (research.md R6). The ids and reasons come
// from the card's frontmatter, so the body never repeats them. A card that is not written
// yet shows as text with a hidden "not yet available": no badge, link or `cd` hint (FR-018).
import { getCollection, getEntry } from 'astro:content';
import { resolveRelated } from '../lib/cards/related.ts';
import { parseTopics } from '../lib/topics.ts';
import topicsMarkdown from '../../docs/TOPICS.md?raw';

const card = await getEntry('cards', Astro.params.id!);
const written = (await getCollection('cards')).map((c) => c.data);
// Topic list errors are the validator's job; the page only needs the titles.
const { topics } = parseTopics(topicsMarkdown, 'docs/TOPICS.md');
const items = resolveRelated(card?.data.related ?? [], written, topics);
---

<div class="related">
  {
    items.map((item) =>
      item.available ? (
        <a class="rel" href={item.href}>
          <span class="top">
            <b>{item.title}</b>
            <span class={`radar sm ${item.status}`}>{item.status.toUpperCase()}</span>
          </span>
          <span class="why">{item.why}</span>
          <span class="cd" aria-hidden="true">cd ../{item.id}</span>
        </a>
      ) : (
        <div class="rel planned">
          <span class="top">
            <b>{item.title}</b>
          </span>
          <span class="why">{item.why}</span>
          <span class="sr-only">not yet available</span>
        </div>
      ),
    )
  }
</div>
