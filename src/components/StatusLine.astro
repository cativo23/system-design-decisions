---
// tmux-style status line, always on screen. Decorative: the same facts are in the page (aria-hidden).
// Shows only the fields the page has (statusFields); the position field is set live by shell.ts.
import type { StatusFields } from '../lib/discovery/status-fields.ts';

interface Props {
  fields: StatusFields;
}
const { mode, domain, file, status, progress } = Astro.props.fields;
---

<div class="statusline" aria-hidden="true">
  <span class="mode">{mode}</span>
  {domain && <span class="hide-sm">{domain}</span>}
  {file && <span>{file}</span>}
  {status && <span class:list={['hide-sm', `st-${status}`]}>● {status}</span>}
  {progress && <span class="hide-sm">{progress}</span>}
  <span class="grow"></span>
  <span class="pct" id="sl-pct">top</span>
</div>
