---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { domainBySlug } from '../lib/domains.ts';

// Learning-path order: domain number, then the card's order within it (FR-020a).
const cards = (await getCollection('cards'))
  .map((card) => ({ ...card.data, domain: domainBySlug(card.data.domain)! }))
  .sort((a, b) => a.domain.number - b.domain.number || a.order - b.order);
---

<Base title="Systems Field Guide">
  <main>
    <h1>Systems Field Guide</h1>
    <ul>
      {
        cards.map((card) => (
          <li>
            <a href={`/cards/${card.id}/`}>{card.title}</a> · {card.domain.name} · {card.status.toUpperCase()}
          </li>
        ))
      }
    </ul>
  </main>
</Base>
