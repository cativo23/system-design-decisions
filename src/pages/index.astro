---
// The home (FR-013): hero, two entry points, the 13 domains, and the freshness strip. Replaces the Phase 1 index.
import { getCollection } from 'astro:content';
import DomainTile from '../components/DomainTile.astro';
import Shell from '../layouts/Shell.astro';
import { buildCatalog, toPublished } from '../lib/discovery/catalog.ts';
import { freshness } from '../lib/discovery/freshness.ts';
import { parseTopics } from '../lib/topics.ts';
import topicsMarkdown from '../../docs/TOPICS.md?raw';

// Topic list errors are the validator's job; the page only needs ids, titles and domains.
const { topics } = parseTopics(topicsMarkdown, 'docs/TOPICS.md');
const cards = toPublished(await getCollection('cards'));
const catalog = buildCatalog(topics, cards);
const recent = freshness(cards);
---

<Shell title="Systems Field Guide" kind="home">
  <div class="home">
    <section class="hero" aria-labelledby="home-title">
      <div class="prompt"><span class="path">~</span><span class="sym">❯</span><span class="cmd">cat README.md</span></div>
      <h1 id="home-title">Systems Field Guide</h1>
      <p class="lede">
        A field guide to how software systems are built in industry. Each card is one decision: the problem it solves, how it works,
        when to use it and when to avoid it, and what it costs.
      </p>
      <p class="for">For engineers who design or review systems and want the trade-offs, not a tutorial.</p>
      <div class="entries">
        <a class="btn primary" href="/path/">Start the learning path</a>
        <button type="button" class="btn search-entry" data-open-palette aria-haspopup="dialog">Search <kbd aria-hidden="true">/</kbd></button>
      </div>
    </section>

    <section aria-labelledby="domains-title">
      <h2 id="domains-title" class="section-title">Domains</h2>
      <ul class="tiles">
        {catalog.map((summary) => <DomainTile summary={summary} />)}
      </ul>
    </section>

    <section aria-labelledby="fresh-title">
      <h2 id="fresh-title" class="section-title">Recently reviewed</h2>
      {
        recent.length === 0 ? (
          <p class="empty">No cards are published yet.</p>
        ) : (
          <ol class="fresh">
            {recent.map((item) => (
              <li>
                <a href={item.href}>{item.title}</a>
                <span class={`radar sm ${item.status}`}>{item.status.toUpperCase()}</span>
                <span class="when">reviewed {item.reviewed}</span>
              </li>
            ))}
          </ol>
        )
      }
    </section>
  </div>
</Shell>
